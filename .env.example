# Copy to .env.local for local development. On Railway, set the same names as
# service variables (NEXT_PUBLIC_* must exist at build time — Railway provides
# service variables to the build, so setting them on the service is enough).

# Public URL of this app, no trailing slash. Used for OAuth and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row-level security — never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend → API Keys. Also used as the SMTP password for Supabase Auth emails.
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend.
EMAIL_FROM="Grouv <hello@your-domain.com>"

# Only needed by the Supabase CLI (supabase/config.toml) for local auth config.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Any long random string. A scheduler calls POST /api/cron/notification-emails
# with "Authorization: Bearer <CRON_SECRET>" to send queued notification emails.
CRON_SECRET=
