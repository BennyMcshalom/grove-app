# Copy to .env.local for local development and put real values there — this
# file is committed, so keep only placeholders here. On Railway, set the same
# names as service variables (NEXT_PUBLIC_* must exist at build time — Railway
# provides service variables to the build, so setting them on the service is
# enough).

# Public URL of this app, no trailing slash. Used for OAuth and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row-level security — never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend → API Keys. Also used as the SMTP password for Supabase Auth emails.
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend.
EMAIL_FROM="Grouv <hello@your-domain.com>"

# Only needed by the Supabase CLI (supabase/config.toml) for local auth config.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Any long random string. A scheduler calls POST /api/cron/notification-emails
# with "Authorization: Bearer <CRON_SECRET>" to send queued notification emails.
# Next.js expands $NAME in .env files, so escape a literal dollar as \$.
CRON_SECRET=

# RevenueCat. Leave the keys blank to hide Subscribe / Manage billing.
# Project settings → API keys → the Web Billing public key (rcb_...).
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
# Project settings → API keys → a secret key with API version V1 (sk_...). Server only.
REVENUECAT_SECRET_API_KEY=
# The entitlement that means "full access" (Product catalog → Entitlements).
REVENUECAT_ENTITLEMENT_ID=full_access
# Integrations → Webhooks: the Authorization header value you set there.
REVENUECAT_WEBHOOK_AUTH=
# Optional: the webhook's HMAC signing secret, if signing is switched on.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Only "true" while testing with sandbox purchases; never in production.
REVENUECAT_ALLOW_SANDBOX=false

# LiveKit Cloud → Settings → Keys (free Build plan). Leave blank to hide calling.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Geocoding uses OpenStreetMap's free Nominatim by default; a LocationIQ
# key (free tier: 5,000 lookups a day) switches to their compatible API.
LOCATIONIQ_API_KEY=
