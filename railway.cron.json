{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo \"No build needed for the cron service\""
  },
  "deploy": {
    "startCommand": "node scripts/cron/notification-emails.mjs",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "NEVER"
  }
}
